apiVersion: v1
kind: ConfigMap
metadata:
  name: fluentd-config
  namespace: logging
  labels:
    app.kubernetes.io/managed-by: devops-foundation
data:
  fluent.conf: |
{{ fluentd_config | indent(4, true) }}
  health.rb: |
{{ fluentd_health | indent(4, true) }}
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: fluentd
  namespace: logging
  labels:
    app.kubernetes.io/managed-by: devops-foundation
spec:
  revisionHistoryLimit: 2
  minReadySeconds: 5
  updateStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 1
      maxSurge: 0
  selector:
    matchLabels:
      app.kubernetes.io/name: fluentd
  template:
    metadata:
      labels:
        app.kubernetes.io/name: fluentd
      annotations:
        checksum/fluentd-config: {{ fluentd_config | hash('sha256') | to_json }}
        checksum/fluentd-health: {{ fluentd_health | hash('sha256') | to_json }}
    spec:
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 30
      nodeSelector:
        kubernetes.io/hostname: {{ logging_node_hostname | to_json }}
        kubernetes.io/os: linux
      tolerations:
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
          effect: NoSchedule
      securityContext:
        runAsUser: 0
        runAsGroup: 0
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: check-config
          image: {{ fluentd_image | to_json }}
          imagePullPolicy: IfNotPresent
          command: [fluentd]
          args: [--dry-run, -c, /fluentd/etc/fluent.conf]
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          securityContext:
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {cpu: 300m, memory: 256Mi}
          volumeMounts:
            - name: config
              mountPath: /fluentd/etc
              readOnly: true
            - name: data
              mountPath: /data
            - name: tmp
              mountPath: /tmp
      containers:
        - name: fluentd
          image: {{ fluentd_image | to_json }}
          imagePullPolicy: IfNotPresent
          command: [fluentd]
          args: [--no-supervisor, -c, /fluentd/etc/fluent.conf]
          env:
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
          securityContext:
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {cpu: 500m, memory: 384Mi}
          startupProbe:
            exec:
              command: [ruby, /fluentd/etc/health.rb]
            periodSeconds: 5
            timeoutSeconds: 5
            failureThreshold: 36
          readinessProbe:
            exec:
              command: [ruby, /fluentd/etc/health.rb]
            periodSeconds: 10
            timeoutSeconds: 5
          livenessProbe:
            exec:
              command: [ruby, /fluentd/etc/health.rb]
            periodSeconds: 30
            timeoutSeconds: 5
          volumeMounts:
            - name: config
              mountPath: /fluentd/etc
              readOnly: true
            - name: pod-logs
              mountPath: /var/log/pods
              readOnly: true
            - name: data
              mountPath: /data
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: config
          configMap:
            name: fluentd-config
        - name: pod-logs
          hostPath:
            path: /var/log/pods
            type: Directory
        - name: data
          hostPath:
            path: /var/lib/devops-foundation/fluentd
            type: Directory
        - name: tmp
          emptyDir:
            sizeLimit: 32Mi
