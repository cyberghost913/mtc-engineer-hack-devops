apiVersion: gateway.envoyproxy.io/v1alpha1
kind: EnvoyProxy
metadata:
  name: demo-proxy
  namespace: demo
  labels:
    app.kubernetes.io/managed-by: devops-foundation
spec:
  provider:
    type: Kubernetes
    kubernetes:
      envoyService:
        type: NodePort
        externalTrafficPolicy: Cluster
      envoyDeployment:
        replicas: 1
        container:
          image: {{ envoy_proxy_image | to_json }}
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
---
apiVersion: gateway.networking.k8s.io/v1
kind: GatewayClass
metadata:
  name: devops-envoy
  labels:
    app.kubernetes.io/managed-by: devops-foundation
spec:
  controllerName: gateway.envoyproxy.io/gatewayclass-controller
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: demo-gateway
  namespace: demo
  labels:
    app.kubernetes.io/managed-by: devops-foundation
spec:
  gatewayClassName: devops-envoy
  infrastructure:
    parametersRef:
      group: gateway.envoyproxy.io
      kind: EnvoyProxy
      name: demo-proxy
  listeners:
    - name: http
      protocol: HTTP
      port: 80
      hostname: {{ gateway_hostname | to_json }}
      allowedRoutes:
        namespaces:
          from: Same
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: nginx
  namespace: demo
  labels:
    app.kubernetes.io/managed-by: devops-foundation
spec:
  parentRefs:
    - name: demo-gateway
      sectionName: http
  hostnames:
    - {{ gateway_hostname | to_json }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      filters:
        - type: ResponseHeaderModifier
          responseHeaderModifier:
            set:
              - name: X-Gateway
                value: envoy-gateway
      backendRefs:
        - name: nginx
          port: 80
